---
import Layout from '../layouts/Layout.astro';
import IsrCard from '../components/IsrCard.astro';

export const prerender = false;
---

<Layout title="Appwrite ISR cache playground">
  <div class="grid gap-5 md:grid-cols-2">
    <IsrCard
      title="Time-based"
      badge="60s TTL"
      endpoint="/v1/isr/cache-controled-date"
    />
    
    <IsrCard
      title="Path-based"
      badge="1 year TTL"
      endpoint="/v1/isr/pathed-date"
    >
      <Fragment slot="actions">
        <button
          class="btn"
          data-variant="outline"
          data-size="sm"
          type="button"
          data-invalidate="path"
          data-reference="/v1/isr/pathed-date"
        >
          Purge path
        </button>
      </Fragment>
    </IsrCard>
    
    <IsrCard
      title="Key-based"
      badge="Cache tags + 1 year TTL"
      endpoint="/v1/isr/keyed-date"
    >
      <Fragment slot="actions">
        <button
          class="btn"
          data-variant="outline"
          data-size="sm"
          type="button"
          data-invalidate="tag"
          data-reference="key123"
        >
          Purge key123
        </button>
        <button
          class="btn"
          data-variant="outline"
          data-size="sm"
          type="button"
          data-invalidate="tag"
          data-reference="key456"
        >
          Purge key456
        </button>
      </Fragment>
    </IsrCard>

    <IsrCard
      title="Wildcard"
      badge="24h TTL"
      endpoint="/v1/isr/wildcarded-date"
    >
      <Fragment slot="actions">
        <button
          class="btn"
          data-variant="destructive"
          data-size="sm"
          type="button"
          data-invalidate="all"
        >
          Purge everything
        </button>
      </Fragment>
    </IsrCard>
  </div>
</Layout>
