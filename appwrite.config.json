{
    "organizationId": "almostApps",
    "projectId": "isr-demo",
    "projectName": "ISR demo",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "functions": [
        {
            "$id": "api",
            "name": "api",
            "runtime": "node-26",
            "buildSpecification": "s-2vcpu-2gb",
            "runtimeSpecification": "s-1vcpu-1gb",
            "execute": [
                "any"
            ],
            "events": [],
            "scopes": [
                "proxy.invalidations.write"
            ],
            "schedule": "",
            "timeout": 15,
            "enabled": true,
            "logging": true,
            "entrypoint": "src/main.js",
            "commands": "npm install --allow-remote=all",
            "ignore": [
                "node_modules",
                ".npm"
            ],
            "deploymentRetention": 0,
            "path": "functions/api"
        }
    ],
    "sites": [
        {
            "$id": "isr-site",
            "name": "ISR Site",
            "framework": "astro",
            "adapter": "ssr",
            "buildRuntime": "node-22",
            "installCommand": "npm install",
            "buildCommand": "npm run build",
            "outputDirectory": "./dist",
            "fallbackFile": "",
            "buildSpecification": "s-4vcpu-4gb",
            "runtimeSpecification": "s-4vcpu-4gb",
            "deploymentRetention": 7,
            "timeout": 30,
            "logging": true,
            "path": "./",
            "installationId": "",
            "providerRepositoryId": "",
            "providerBranch": "",
            "providerSilentMode": false,
            "providerRootDirectory": "",
            "startCommand": ""
        }
    ]
}